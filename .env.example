# OpenAI-compatible LLM endpoint
# NVIDIA hosted: https://integrate.api.nvidia.com/v1
# Ollama: http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_key_here

# Crew Model Assignments (Verify availability with: python scripts/list_models.py)
DRAFTER_MODEL=meta/llama-3.1-70b-instruct
JUDGE_MODEL=mistralai/mixtral-8x22b-instruct-v0.1
VISION_MODEL=google/gemma-3-27b-it
SCANNER_MODEL=nemotron-3-nano-30b-a3b

# GitHub integration for issue creation & inspection
GITHUB_TOKEN=ghp_your_github_token_here
TARGET_REPO=your-org-or-username/demo-repo

# Demo mode: "live" for real model calls, "cached" to replay pre-recorded runs
DEMO_MODE=live
