# LLM Provider Configuration
# NVIDIA hosted API: https://integrate.api.nvidia.com/v1
# Local Ollama:      http://localhost:11434/v1
# Local LM Studio:   http://localhost:1234/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_key_here

# Open-Weight Crew Model Assignments (run python scripts/list_models.py to verify available models)
DRAFTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JUDGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
SCANNER_MODEL=

# Role justifications displayed directly in the UI
DRAFTER_WHY=Strong reasoning model that writes and rewrites newcomer issues
JUDGE_WHY=Different model family from the drafter, so it does not grade its own work
VISION_WHY=Multimodal vision model that reads bug screenshots
SCANNER_WHY=Small fast model that shortlists contribution opportunities

# Model licensing notes
DRAFTER_LICENSE=open-weight
JUDGE_LICENSE=open-weight
VISION_LICENSE=open-weight
SCANNER_LICENSE=open-weight

# GitHub Integration
GITHUB_TOKEN=your_personal_access_token_here
TARGET_REPO=owner/demo-repo

# Demo mode: "live" for real model calls, "cached" to replay pre-recorded runs
DEMO_MODE=live
